<root BTCPP_format="4" main_tree_to_execute="FleetMain">
  <BehaviorTree ID="FleetMain">

    <!-- ReactiveSequence ticks every child each tick.
         FormationHealthMonitor runs first so its escalations of @action_status
         and formation_* fields land in this same tick's /bt/state snapshot.
         BTStatePublisher then snapshots blackboard for /bt/state.
         LlmCommandReceiver applies any pending external command. -->

    <ReactiveSequence>

      <FormationHealthMonitor/>

      <BTStatePublisher/>

      <LlmCommandReceiver/>

      <ReactiveFallback name="ModeDispatch">

        <CheckMode mode="{@mode}" expected="idle"/>

        <Sequence name="MapfBranch">
          <CheckMode mode="{@mode}" expected="mapf"/>
          <RunOnce trigger="{@command_seq}">
            <MapfPlan
              robot_ids="{@robot_ids}"
              goals="{@goals}"/>
          </RunOnce>
        </Sequence>

        <Sequence name="FormationBranch">
          <CheckMode mode="{@mode}" expected="formation"/>
          <RunOnce trigger="{@command_seq}">
            <SetFormation
              formation_id="{@formation_id}"
              leader_ns="{@leader_ns}"
              follower_ns="{@follower_ns}"
              offsets_x="{@offsets_x}"
              offsets_y="{@offsets_y}"
              activate="true"
              formation_enabled="{@formation_enabled}"
              active_formation="{@active_formation}"
              formation_warn="{@formation_warn}"/>
          </RunOnce>
        </Sequence>

      </ReactiveFallback>

    </ReactiveSequence>

  </BehaviorTree>
</root>