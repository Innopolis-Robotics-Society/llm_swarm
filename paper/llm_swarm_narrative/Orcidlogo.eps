%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 9 9
%%HiResBoundingBox: 0 0 9 9
%%Creator: hand-written ORCID iD mark
%%Title: Orcidlogo.eps
%%EndComments
%%BeginProlog
/rr { % x y w h r -> rounded-rect path
  5 dict begin
  /r exch def /h exch def /w exch def /y exch def /x exch def
  newpath
  x r add y moveto
  x w add r sub y lineto
  x w add y  x w add y r add  r arcto 4 {pop} repeat
  x w add y h add r sub lineto
  x w add y h add  x w add r sub y h add  r arcto 4 {pop} repeat
  x r add y h add lineto
  x y h add  x y h add r sub  r arcto 4 {pop} repeat
  x y r add lineto
  x y  x r add y  r arcto 4 {pop} repeat
  closepath
  end
} bind def
%%EndProlog
0.651 0.808 0.224 setrgbcolor
0 0 9 9 1.9 rr fill
1 1 1 setrgbcolor
/Helvetica-Bold findfont 5.4 scalefont setfont
1.8 2.45 moveto
(iD) show
showpage
%%EOF
